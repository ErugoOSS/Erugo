# DO NOT COPY THIS FILE BY HAND. Use the bootstrap script:
#
#   sh scripts/mesh-bootstrap.sh
#
# It asks for this host's node id, its public HTTPS URL and the coordinator
# API URL reachable from this host. It generates unique APP_KEY/JWT_SECRET and
# a random MESH_SECRET placeholder. Enrolled peers use Ed25519 identities, so
# that placeholder is never shared between hosts.
#
# See docs/MESH-DEV.md for the full enrollment and gateway setup.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://peer1.example.com
APP_KEY=base64:generated-unique-per-host
JWT_SECRET=generated-unique-per-host

MESH_ENABLED=true
MESH_SECRET=generated-legacy-fallback-only
MESH_NODE_ID=peer1
MESH_NODES='{"peer1":"https://peer1.example.com","peer2":"https://peer2.example.com"}'
MESH_COORDINATOR_URL=https://studio.example.com
MESH_BIND=127.0.0.1:8090
TRUSTED_PROXIES=

MESH_CHUNK_SIZE=8388608
MESH_WRITE_COPIES=2
MESH_TOKEN_TTL=300
MESH_MAX_TOKEN_TTL=900

GIT_SHA=dev
INSTALL_ASR=0
