# DO NOT COPY THIS FILE BY HAND. Use the bootstrap script, which generates
# unique APP_KEY/JWT_SECRET for each host and writes a valid .env.mesh:
#
#   sh scripts/mesh-bootstrap.sh
#
# The script asks for this host's node id, its private IP, the coordinator API
# URL reachable from this host, and the SHARED mesh secret. If you must edit
# manually, every placeholder below MUST be replaced before starting Docker.
#
# Values marked SHARED must be identical on the coordinator and every peer.
# Other secrets must be unique per host. See docs/MESH-DEV.md for the full
# checklist, gateway override and verification commands.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://peer1.example.test
APP_KEY=base64:generate-a-unique-32-byte-key-per-host
JWT_SECRET=generate-a-unique-jwt-secret-per-host

# SHARED across all mesh instances. Use a fresh random value, not the one in
# docker-compose.mesh-dev.yml.
MESH_SECRET=replace-with-a-long-random-shared-secret

# Unique on each host: coordinator, peer1, peer2.
MESH_NODE_ID=peer1

# SHARED map of node ids. Values are informational on peers; the coordinator
# uses the keys to issue chunk tokens.
MESH_NODES='{"peer1":"http://peer1:80","peer2":"http://peer2:80"}'

# Base URL of the coordinator API, reachable FROM THIS PEER. A peer sends
# signed placement callbacks here after it stores a chunk.
MESH_COORDINATOR_URL=http://coordinator:8090

# Private bind address. The gateway, not the public internet, reaches this.
MESH_BIND=127.0.0.1:8090

# Leave empty unless this instance sits behind a trusted reverse proxy.
TRUSTED_PROXIES=

MESH_CHUNK_SIZE=8388608
MESH_WRITE_COPIES=2
MESH_TOKEN_TTL=300
MESH_MAX_TOKEN_TTL=900

GIT_SHA=dev
INSTALL_ASR=0
