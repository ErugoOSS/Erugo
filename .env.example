APP_NAME=Erugo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

JWT_SECRET=
JWT_ALGO=HS256

# Key that tusd must send with every hook call to /api/tusd-hooks. Erugo
# refuses hook calls without it, so uploads fail if this is empty. The Docker
# image makes a random one at every boot when it is unset, so leave it empty
# there. Set it only if you run tusd yourself, and then pass it to tusd as the
# password in the hook URL: -hooks-http http://tusd:<key>@127.0.0.1/api/tusd-hooks
# Letters, digits and . _ ~ - only. See config/services.php.
TUSD_HOOK_SECRET=

# Frontend Variables
VITE_API_URL=http://localhost
