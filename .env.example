APP_NAME=Erugo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Comma separated proxy addresses/CIDRs, or "*" when Erugo is only reachable
# through a reverse proxy. Needed for per-client rate limits and the IP
# allowlist to see the real visitor address.
#
# Behind Cloudflare: use "*" (the container is not reachable any other way), or
# list the ranges from https://www.cloudflare.com/ips-v4 so X-Forwarded-For is
# only trusted from Cloudflare itself.
# TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

JWT_SECRET=
JWT_ALGO=HS256

# Frontend Variables
VITE_API_URL=http://localhost

# Mesh storage (phase 1; opt-in, dev/testing only)
# MESH_ENABLED=false
# MESH_NODE_ID=coordinator
# MESH_COORDINATOR_URL=http://coordinator
# MESH_CHUNK_ROOT=/var/www/html/storage/app/mesh
# MESH_SECRET=replace-with-a-long-random-value-at-least-32-bytes
# MESH_NODES={"peer1":"http://peer1:80","peer2":"http://peer2:80"}
# MESH_CHUNK_SIZE=8388608
# MESH_WRITE_COPIES=2
# MESH_MAX_UPLOAD_BYTES=4294967296
# MESH_MAX_CHUNKS=10000
# MESH_TOKEN_TTL=300
# MESH_MAX_TOKEN_TTL=900
