APP_NAME=Erugo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

JWT_SECRET=
JWT_ALGO=HS256

# Optional tusd hook shared secret, checked on top of the internal IP check.
# The bundled tusd can't send it, so leave it empty unless a proxy between
# tusd and Erugo adds a Hook-Secret header. See config/services.php.
TUSD_HOOK_SECRET=

# Frontend Variables
VITE_API_URL=http://localhost
